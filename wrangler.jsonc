{
  "name": "atelier-flip7",
  "main": "worker.js",
  "compatibility_date": "2025-01-01",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/kart-ws","/pool-ws","/park-ws"] },
  "durable_objects": { "bindings": [{ "name": "KART", "class_name": "KartHub" }, { "name": "PARK", "class_name": "ParkHub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["KartHub"] }, { "tag": "v2", "new_sqlite_classes": ["ParkHub"] }]
}
